      "title": "Input",
      "dependencies": ["@base-ui/react", "cn"],
      "files": [{ "path": "src/components/ui/input.tsx", "type": "registry:ui" }]
    },
    {
      "name": "label",
      "type": "registry:ui",
      "title": "Label",
      "dependencies": ["cn"],
      "files": [{ "path": "src/components/ui/label.tsx", "type": "registry:ui" }]
    },
    {
      "name": "separator",
      "type": "registry:ui",
      "title": "Separator",
      "dependencies": ["@base-ui/react", "cn"],
